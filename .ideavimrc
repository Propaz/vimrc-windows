" ============================================================================
"  ~/.ideavimrc -- IdeaVim in IntelliJ IDEA and Rider on Windows
"
"  Companion to dotfiles\vim\_vimrc: the leader scheme is deliberately SHARED
"  between the two, so muscle memory carries from gVim into the IDE and back.
"  Do not repurpose a key on one side without the other.
"
"  Key map, install, requirements:  README.md
"  Why any non-obvious value:       docs/RATIONALE.md
"
"  Verified against IdeaVim 2.46.2: option names, plugin names and every
"  <Action> id. IdeaVim reports an unknown option as "E518" -- it does not
"  abort the file, but it flags the config as broken on every start, so
"  nothing Vim has and IdeaVim lacks belongs in here.
" ============================================================================

" ============================================================================
"  Generic settings
"
"  IdeaVim implements a SUBSET of Vim's options (~60). Indentation, the status
"  bar and the file lifecycle belong to the IDE, so their Vim options are
"  absent here on purpose -- see docs/RATIONALE.md#ideavim-option-subset.
" ============================================================================
set number
set relativenumber
set scrolloff=8
set cursorline
set hlsearch
set incsearch
set ignorecase
set smartcase

" Matches _vimrc; safe only while the leader groups stay prefix-free.
set timeoutlen=600

" '^=' PREPENDS. A plain 'set clipboard=unnamed,unnamedplus' would DISCARD
" IdeaVim's default "ideaput,autoselect", and losing 'ideaput' costs every
" IDE paste handler: auto-import, reindent, the Java-to-Kotlin prompt.
" On Windows '*' and '+' are the same clipboard, so 'unnamedplus' suffices.
" Unlike _vimrc, deletes reach the clipboard too: IdeaVim has no
" TextYankPost, so the yank-only trick does not port. Mappings that must not
" touch the clipboard name a register explicitly (see "zy below).
set clipboard^=unnamedplus

" ============================================================================
"  IdeaVim integration
" ============================================================================
set ideajoin                      " J uses the IDE's smart join
set idearefactormode=keep         " stay in Normal mode during inline refactorings

" Uncomment temporarily to learn action ids -- beats guessing <Action>() names.
" set trackactionids

" ============================================================================
"  Emulated Vim plugins
"
"  Names IdeaVim 2.46.2 actually registers. What else ships and why it is off:
"  docs/RATIONALE.md#ideavim-bundled-plugins
" ============================================================================
set surround
set commentary                    " gcc / gc{motion} / gcap
set highlightedyank               " briefly highlight the yanked region
set ReplaceWithRegister           " grr / gr{motion} -- paste OVER the target
set argtextobj                    " aa / ia -- function argument
set textobj-entire                " ae / ie -- whole buffer
set matchit                       " % jumps between matching keywords/tags
let g:highlightedyank_highlight_duration = "200"

" ============================================================================
"  Leader key
"
"  INVARIANT: no leader mapping may be a PREFIX of another, or it waits out
"  'timeoutlen'. Groups: ,c* ,g* ,h* ,r* ,t* ,=* ,v* -- everything else is a
"  leaf. The ,r* group is nmap-only so it never shadows Visual-mode ,r.
" ============================================================================
let mapleader=","

" ============================================================================
"  sethandler -- who owns a shortcut in the editor
"
"  Without this the IDE swallows the key before IdeaVim sees it.
" ============================================================================
sethandler <C-S-c> a:vim          " IDE: Copy Reference
sethandler <C-S-v> a:vim          " IDE: Paste from History
sethandler <A-j>   a:vim          " IDE: Add Selection for Next Occurrence
sethandler <A-k>   a:vim
sethandler <F5>    a:vim          " IDE: Copy (refactoring)

" ============================================================================
"  Files, navigation and windows
"
"  `map` is fine for <Action> mappings -- there is no Vim command underneath
"  to recurse into -- and it covers Normal/Visual/Operator-pending at once.
"  `nnoremap`/`xnoremap` are used wherever the right-hand side is real Vim.
" ============================================================================
map <leader>f <Action>(FindInPath)
map <leader>F <Action>(GotoFile)
map <leader>u <Action>(FindUsages)
map <leader>l <Action>(FileStructurePopup)
map <leader>b <Action>(Switcher)
map <leader>e <Action>(ActivateProjectToolWindow)
map <leader>w <Action>(SaveAll)
map <leader>d <Action>(CloseEditor)
map <leader>n <Action>(NextTab)
map <leader>p <Action>(PreviousTab)

" Not mapped, deliberately: Search Everywhere is Shift+Shift, and `gd` / `gD`
" are built into IdeaVim -- so ,gd stays free for git diff, as in _vimrc.

" History
map <leader>hh <Action>(RecentFiles)
map <leader>hc <Action>(RecentChanges)
nmap <F5> <Action>(LocalHistory.ShowHistory)

" `gt` takes a count in IdeaVim exactly as in Vim.
nnoremap <leader>1 1gt
nnoremap <leader>2 2gt
nnoremap <leader>3 3gt
nnoremap <leader>4 4gt
nnoremap <leader>5 5gt
nnoremap <leader>6 6gt
nnoremap <leader>7 7gt
nnoremap <leader>8 8gt
nnoremap <leader>9 9gt

" Splits (<C-w>v / <C-w>s / <C-w>hjkl / <C-w>c) are native in IdeaVim.

" ============================================================================
"  Problems  (mirrors the ALE mappings in _vimrc)
" ============================================================================
nmap [g <Action>(GotoPreviousError)
nmap ]g <Action>(GotoNextError)

" ============================================================================
"  Run / debug / refactor
" ============================================================================
nmap <leader>rr <Action>(Run)
nmap <leader>rd <Action>(Debug)
nmap <leader>rs <Action>(Stop)
nmap <leader>rn <Action>(RenameElement)
nmap <leader>rf <Action>(Refactorings.QuickListPopupAction)

" ============================================================================
"  Version control
" ============================================================================
map <leader>gb <Action>(Annotate)
map <leader>gl <Action>(Vcs.ShowTabbedFileHistory)
" Compare.SameVersion = diff against the repository version, i.e. what ,gd
" does in _vimrc via :Ghdiffsplit.
map <leader>gd <Action>(Compare.SameVersion)
map <leader>gs <Action>(Vcs.Show.Local.Changes)
map <leader>gp <Action>(Git.Pull)

" ============================================================================
"  Copy to clipboard
"
"  IdeaVim has no expand()/setreg()/getreg(), so the IDE actions do the work.
"  ,cd and ,cm stay gVim-only: no :lcd and no execute() here.
" ============================================================================
map <leader>cf <Action>(CopyFileName)
map <leader>cp <Action>(CopyAbsolutePath)

" ============================================================================
"  Format
" ============================================================================
map <leader>=f <Action>(ReformatCode)
" No ':keeppatterns' in IdeaVim, so clear the highlight explicitly.
nnoremap <silent> <leader>=r :%s/\r//ge<CR>:noh<CR>

" ============================================================================
"  Toggles
" ============================================================================
nnoremap <silent> <leader>tr :set relativenumber!<CR>
nnoremap <silent> <leader>th :set hlsearch!<CR>
map <leader>T <Action>(ActivateTerminalToolWindow)

" ============================================================================
"  Editing
" ============================================================================
map <leader>a <Action>($SelectAll)
map <leader>/ <Action>(CommentByLineComment)

" Blank line below/above without leaving the current line.
nnoremap <leader>o o<Esc>k
nnoremap <leader>O O<Esc>j

nnoremap <silent> <leader><space> :noh<CR>

" MoveLineDown/Up is the plain line move, i.e. what _vimrc's ':m' does.
" (MoveStatementDown/Up is the syntax-aware one -- not bound here.)
map <leader>j <Action>(MoveLineDown)
map <leader>k <Action>(MoveLineUp)
map <A-j> <Action>(MoveLineDown)
map <A-k> <Action>(MoveLineUp)
imap <A-j> <Action>(MoveLineDown)
imap <A-k> <Action>(MoveLineUp)

" ============================================================================
"  This config
" ============================================================================
" ':split', not ':edit'. In IdeaVim 2.46.2 ':edit' does NOT run its argument
" through path expansion, so ':e ~/.ideavimrc' fails to find the file.
nnoremap <leader>vm :split ~/.ideavimrc<CR>
nnoremap <leader>vs :source ~/.ideavimrc<CR>

" ============================================================================
"  Visual mode
"
"  "z is an EXPLICIT register: IdeaVim only routes a yank through 'clipboard'
"  when no register was named, so this leaves the system clipboard alone.
"  '\V' (very nomagic) makes the selection literal, so text containing '.',
"  '*' or '[' is searched for as characters, not as a broken regex.
"  A selection containing '/' or a newline still needs a manual fix-up --
"  IdeaVim has no expression register on the search line and no substitute().
" ============================================================================
xnoremap <silent> * "zy/\V<C-R><C-R>z<CR>
xnoremap <silent> # "zy?\V<C-R><C-R>z<CR>

" NOT <silent>: the command line has to stay on screen for the replacement.
xnoremap <leader>r "zy:%s/\V<C-R><C-R>z//g<Left><Left>

" ============================================================================
"  Explicit clipboard keys
"
"  'clipboard' already routes y/p/d/x through the system clipboard; these add
"  Ctrl+Shift+C / Ctrl+Shift+V on top and deliberately leave Ctrl+V (Visual
"  block) and Ctrl+C alone.
" ============================================================================
xnoremap <C-S-c> "+y
nnoremap <C-S-c> "+yy

nnoremap <C-S-v> "+p
xnoremap <C-S-v> "_d"+P
inoremap <C-S-v> <C-r>+
cnoremap <C-S-v> <C-r>+
