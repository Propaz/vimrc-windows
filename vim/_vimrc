" ============================================================================
"  _vimrc -- gvim.exe 9.2 x64, Win32 GUI, DirectWrite
"  Rationale: docs/RATIONALE.md    Key map: README.md
" ============================================================================
set nocompatible            " implied for ~/_vimrc, but not under 'gvim -u'
set fileencodings=ucs-bom,utf-8,cp1251,latin1

" Before plugins load, or their <Leader> mappings bind to the old leader.
let mapleader = ","

" ============================================================================
"  Shell
" ============================================================================
" ONLY 'shell'. Vim derives the rest (shcf=/c, sxq=(, sxe) after the vimrc,
" but only for options left unset here -- set any of them and vim-go's
" 'set shellxquote&' resets it to "" and every go call breaks.
" docs/RATIONALE.md#windows-shell
set shell=cmd.exe

" ============================================================================
"  General
" ============================================================================
set hidden
set history=10000
set undolevels=10000
set autoread
set belloff=all
set backupcopy=yes          " ~/_vimrc is a symlink
set timeoutlen=600          " safe only while leader groups stay prefix-free
set updatetime=300
set splitbelow splitright
set display=truncate
" No 'lazyredraw': torn glyphs under DirectWrite.

" Mirror yanks (not deletes) to the OS clipboard.
augroup YankToClipboard
  autocmd!
  autocmd TextYankPost *
        \ if v:event.operator ==# 'y' && v:event.regname ==# '' |
        \   call setreg('+', v:event.regcontents, v:event.regtype) |
        \ endif
augroup END

" --- Indentation ---
set nowrap
set sidescroll=1
set sidescrolloff=8
set tabstop=4
set shiftwidth=4
set softtabstop=4
set expandtab
set autoindent
set copyindent
set shiftround

" --- Search ---
set ignorecase
set smartcase
set hlsearch
set incsearch

if executable('rg')
  set grepprg=rg\ --vimgrep\ --no-heading\ --smart-case
  set grepformat=%f:%l:%c:%m
endif

" --- UI ---
set number
set relativenumber
set signcolumn=yes
set scrolloff=8
set laststatus=2
set background=dark         " before :colorscheme
set wildmode=longest:full,full
set wildoptions=pum
set wildignore=*.swp,*.bak,*.pyc,*.class,*.o
" No 'showmatch': it jumps the cursor; matchparen highlights in place.

" ============================================================================
"  GUI: font and DirectWrite
"  renmode must stay integer-advance or glyphs drift:
"    3 GDI_NATURAL (default)  2 GDI_CLASSIC  5 NATURAL_SYMMETRIC  0 DEFAULT
"  <F9> rebuild render target, <F10> cycle renmode, :RenderGDI plain GDI.
"  docs/RATIONALE.md#directwrite-glyph-drift
" ============================================================================
if has('gui_running')
  set guifont=Consolas:h14    " no ':cANSI' -- it forces a fallback Cyrillic font
  set linespace=0
  set guicursor=n-v-c:block,i-ci:ver25,r-cr:hor20

  if has('directx')
    let g:gui_renmode = get(g:, 'gui_renmode', 3)
    let g:gui_taamode = get(g:, 'gui_taamode', 1)   " CLEARTYPE
    let g:gui_geom    = get(g:, 'gui_geom', 1)      " RGB stripe

    function! s:RopApply() abort
      let &renderoptions = printf('type:directx,geom:%d,renmode:%d,taamode:%d',
            \ g:gui_geom, g:gui_renmode, g:gui_taamode)
    endfunction

    " <C-l> repaints but keeps the render target, so drift survives it.
    function! s:RenderReset() abort
      let l:saved = &renderoptions
      set renderoptions=
      redraw!
      let &renderoptions = l:saved
      redraw!
      echo 'render reset: ' . &renderoptions
    endfunction

    function! s:RenderCycle() abort
      let l:modes = [3, 2, 5, 0]
      let g:gui_renmode = l:modes[(index(l:modes, g:gui_renmode) + 1) % len(l:modes)]
      call s:RopApply()
      redraw!
      echo 'renmode=' . g:gui_renmode . '  ->  ' . &renderoptions
    endfunction

    function! s:RenderGDI() abort
      set renderoptions=
      redraw!
      echo 'renderer: GDI'
    endfunction

    command! RenderReset call s:RenderReset()
    command! RenderCycle call s:RenderCycle()
    command! RenderGDI   call s:RenderGDI()
    command! RenderDX    call s:RopApply() | redraw!

    nnoremap <silent> <F9>  :RenderReset<CR>
    nnoremap <silent> <F10> :RenderCycle<CR>

    call s:RopApply()
  endif
endif

" ============================================================================
"  State: undo / swap (prune with vim-state-clean.bat)
" ============================================================================
for s:dir in ['~/.vim/.undo', '~/.vim/.backup', '~/.vim/.swp']
