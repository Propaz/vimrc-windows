"  Python toolchain (venv-aware)
" ============================================================================
let g:ale_python_auto_uv = 1
let g:ale_python_auto_virtualenv = 1    " LSP linters only

" ALE completion is LSP-only. First match wins.
let g:python_lsp_preference = get(g:, 'python_lsp_preference',
      \ ['pylsp', 'jedils', 'pyright'])

let s:python_lsp_exe = {
      \ 'pylsp':   'pylsp',
      \ 'jedils':  'jedi-language-server',
      \ 'pyright': 'pyright-langserver',
      \ }
let s:python_lsp_pkg = {
      \ 'pylsp':   'python-lsp-server',
      \ 'jedils':  'jedi-language-server',
      \ 'pyright': 'pyright',
      \ }

let s:python_warned = {}

" Executable inside the venv, else on %PATH%, else ''.
function! s:PyExe(venv, exe) abort
  if !empty(a:venv)
    let l:p = a:venv . '\Scripts\' . a:exe . '.exe'
    if executable(l:p)
      return l:p
    endif
  endif
  return executable(a:exe) ? a:exe : ''
endfunction

function! s:PythonDetect() abort
  let l:info = {'venv': '', 'lsp': '', 'missing': [], 'ale': 1}

  " Not exists('*...'): that is 0 for an unsourced autoload function.
  try
    let l:info.venv = ale#python#FindVirtualenv(bufnr(''))
  catch /^Vim\%((\a\+)\)\=:E117/
    let l:info.ale = 0
  endtry

  for l:name in g:python_lsp_preference
    if !empty(s:PyExe(l:info.venv, get(s:python_lsp_exe, l:name, l:name)))
      let l:info.lsp = l:name
      break
    endif
  endfor

  for l:tool in ['ruff', 'mypy']
    if empty(s:PyExe(l:info.venv, l:tool))
      call add(l:info.missing, l:tool)
    endif
  endfor

  return l:info
endfunction

function! s:PythonSetup() abort
  let l:info = s:PythonDetect()
  if !l:info.ale
    return
  endif

  let b:ale_linters = ['ruff', 'mypy']
        \ + (empty(l:info.lsp) ? [] : [l:info.lsp])

  " Warn once per environment.
  let l:key = empty(l:info.venv) ? '<none>:' . expand('%:p:h') : l:info.venv
  if has_key(s:python_warned, l:key)
    return
  endif
  let s:python_warned[l:key] = 1

  let l:msgs = []
  let l:pkgs = []

  if empty(l:info.venv)
    call add(l:msgs, 'no virtualenv found above this file (looked for '
          \ . join(get(g:, 'ale_virtualenv_dir_names',
          \            ['.venv', 'env', 've', 'venv', 'virtualenv', '.env']), ', ')
          \ . ')')
  endif

  if !empty(l:info.missing)
    call add(l:msgs, 'not installed: ' . join(l:info.missing, ', '))
    call extend(l:pkgs, l:info.missing)
  endif

  if empty(l:info.lsp)
    call add(l:msgs, 'no LSP found -> completion and autoimport are disabled')
    call add(l:pkgs, get(s:python_lsp_pkg, g:python_lsp_preference[0], 'python-lsp-server'))
  endif

  if empty(l:msgs)
    return
  endif

  echohl WarningMsg
  for l:m in l:msgs
    echomsg 'python: ' . l:m
  endfor
  if !empty(l:pkgs)
    echomsg 'python: uv add --dev ' . join(l:pkgs, ' ')
  endif
  echohl None
endfunction

function! s:PythonToolInfo() abort
  let l:info = s:PythonDetect()
  let l:ruff = s:PyExe(l:info.venv, 'ruff')
  let l:mypy = s:PyExe(l:info.venv, 'mypy')
  echo 'venv    : ' . (empty(l:info.venv) ? '(none)' : l:info.venv)
  echo 'lsp     : ' . (empty(l:info.lsp) ? '(none)' : l:info.lsp
        \ . '  ->  ' . s:PyExe(l:info.venv, s:python_lsp_exe[l:info.lsp]))
  echo 'ruff    : ' . (empty(l:ruff) ? '(none)' : l:ruff)
  echo 'mypy    : ' . (empty(l:mypy) ? '(none)' : l:mypy)
  echo 'linters : ' . string(get(b:, 'ale_linters', get(g:ale_linters, 'python', [])))
endfunction
command! PythonToolInfo call s:PythonToolInfo()

