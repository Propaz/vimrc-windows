" ============================================================================
"  Autocommands and Functions
" ============================================================================
" --- Find project root (git) or current file's directory ---
function! FindProjectRoot() abort
  let l:git_root = finddir('.git', '.;')
  if !empty(l:git_root)
    " finddir returns 'path/.git', we want 'path'
    return fnamemodify(l:git_root, ':h')
  endif
  " Fallback to the directory of the current file if no .git dir is found
  return expand('%:p:h')
endfunction

" --- Search for the current visual selection ---
" Yanks into register z, not the unnamed register: that leaves "" intact AND
" keeps the YankToClipboard autocmd above from firing (it only mirrors yanks
" whose regname is empty), so hitting '*' never touches the system clipboard.
" '\V' (very nomagic) makes the selection literal, so selecting text with '.',
" '*' or '[' in it searches for those characters instead of a broken regex.
function! s:VSetSearch(cmdtype) abort
  let l:save_z = getreginfo('z')
  let l:save_unnamed = getreginfo('"')
  normal! gv"zy
  " 'v$y' includes the trailing newline; without stripping it the pattern only
  " matches occurrences that sit at end-of-line.
  let l:text = substitute(@z, '\n\+$', '', '')
  let @/ = '\V' . substitute(escape(l:text, a:cmdtype . '\'), '\n', '\\n', 'g')
  " Yanking into "z also repoints the unnamed register at it, so restore both.
  call setreg('z', l:save_z)
  call setreg('"', l:save_unnamed)
endfunction

augroup ProjectConfig
  autocmd!
  " Python indentation. FileType (not BufRead) so it runs after, and therefore
  " wins over, the bundled python ftplugin.
  autocmd FileType python setlocal expandtab autoindent
        \ tabstop=4 softtabstop=4 shiftwidth=4
  " Pick the venv's LSP/linters for this buffer, and warn once per environment
  " about anything missing.
  autocmd FileType python call s:PythonSetup()
  " Return to last edit position when opening files. Skipped for commit
  " messages, where the cursor belongs on line 1.
  autocmd BufReadPost *
        \ if line("'\"") > 1 && line("'\"") <= line("$")
        \     && &filetype !~# 'commit\|rebase' |
        \   execute "normal! g`\"" |
        \ endif
  " Auto-read files changed from outside.
  autocmd FocusGained,BufEnter * checktime
  " Trailing whitespace is significant in these formats -- do not let the '*'
  " fixer rewrite them on save.
  autocmd FileType markdown,diff,gitcommit let b:ale_fix_on_save = 0
augroup END

" --- Large File Handling ---
let g:LargeFile = 10 * 1024 * 1024 " 10 MB

augroup LargeFile
  autocmd!
  autocmd BufReadPre *
        \ let s:fsize = getfsize(expand('<afile>')) |
        \ if s:fsize > g:LargeFile || s:fsize == -2 | call s:LargeFileMode() | endif
augroup END

" Everything here is buffer-local BY DESIGN. The previous version used global
" 'set eventignore+=FileType', 'filetype off' and 'filetype plugin indent off'
" and never restored them, so opening one big log silently killed syntax
" highlighting and every ftplugin for the WHOLE session until restart.
" ('setlocal syntax=0' was also a no-op -- the value to disable it is OFF.)
function! s:LargeFileMode() abort
  setlocal noswapfile noundofile nobackup
  setlocal bufhidden=unload
  setlocal undolevels=-1
  setlocal syntax=OFF
  setlocal nofoldenable foldmethod=manual
  setlocal nospell
  setlocal nonumber norelativenumber
  let b:ale_enabled = 0
  echomsg printf('Large file mode (%.1f MB): syntax, undo and linting off for this buffer.',
        \ getfsize(expand('%')) / 1024.0 / 1024.0)
endfunction
