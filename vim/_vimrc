" ============================================================================
"  Autocommands and functions
" ============================================================================
" Global, not script-local: it is called from an <expr> mapping, which is not
" evaluated in this script's context.
function! FindProjectRoot() abort
  let l:git_root = finddir('.git', '.;')
  if !empty(l:git_root)
    return fnamemodify(l:git_root, ':h')
  endif
  return expand('%:p:h')
endfunction

" Yanks into "z, not the unnamed register: that leaves "" intact AND keeps the
" YankToClipboard autocmd above from firing, so '*' never touches the system
" clipboard. '\V' (very nomagic) makes the selection literal, so text with
" '.', '*' or '[' in it is searched for as characters, not as a broken regex.
function! s:VSetSearch(cmdtype) abort
  let l:save_z = getreginfo('z')
  let l:save_unnamed = getreginfo('"')
  normal! gv"zy
  " A linewise selection carries a trailing newline; unstripped, the pattern
  " would only match occurrences sitting at end-of-line.
  let l:text = substitute(@z, '\n\+$', '', '')
  let @/ = '\V' . substitute(escape(l:text, a:cmdtype . '\'), '\n', '\\n', 'g')
  " Yanking into "z also repoints the unnamed register, so restore both.
  call setreg('z', l:save_z)
  call setreg('"', l:save_unnamed)
endfunction

augroup ProjectConfig
  autocmd!
  " FileType, not BufRead, so this runs after -- and therefore wins over --
  " the bundled python ftplugin.
  autocmd FileType python setlocal expandtab autoindent
        \ tabstop=4 softtabstop=4 shiftwidth=4
  autocmd FileType python call s:PythonSetup()
  " Return to the last edit position, except in commit messages.
  autocmd BufReadPost *
        \ if line("'\"") > 1 && line("'\"") <= line("$")
        \     && &filetype !~# 'commit\|rebase' |
        \   execute "normal! g`\"" |
        \ endif
  autocmd FocusGained,BufEnter * checktime
  " Trailing whitespace is significant in these formats -- keep the '*' fixer
  " from rewriting them on save.
  autocmd FileType markdown,diff,gitcommit let b:ale_fix_on_save = 0
augroup END

" --- Large files ---
let g:LargeFile = 10 * 1024 * 1024 " 10 MB

augroup LargeFile
  autocmd!
  autocmd BufReadPre *
        \ let s:fsize = getfsize(expand('<afile>')) |
        \ if s:fsize > g:LargeFile || s:fsize == -2 | call s:LargeFileMode() | endif
augroup END

" Everything here is buffer-local BY DESIGN: a global 'filetype off' /
" 'eventignore+=FileType' is never restored, so opening one big log would kill
" syntax and every ftplugin for the WHOLE session. ('syntax=0' is also a
" no-op -- the value that disables it is OFF.)
function! s:LargeFileMode() abort
  setlocal noswapfile noundofile nobackup
  setlocal bufhidden=unload
  setlocal undolevels=-1
  setlocal syntax=OFF
  setlocal nofoldenable foldmethod=manual
  setlocal nospell
  setlocal nonumber norelativenumber
  let b:ale_enabled = 0
  echomsg printf('Large file mode (%.1f MB): syntax, undo and linting off for this buffer.',
        \ getfsize(expand('%')) / 1024.0 / 1024.0)
endfunction
