" ============================================================================
"  _vimrc -- gVim on Windows (gvim.exe 9.2 x64, DirectWrite, UTF-8)
"
"  GUI-first. The few genuinely terminal-only options are guarded with
"  !has('gui_running') so a console fallback still behaves.
"
"  Why any non-obvious value is what it is:  docs/RATIONALE.md
"  Key map, install, requirements:           README.md
" ============================================================================
set nocompatible

" Must be settled before anything touches text, and before DirectWrite.
set encoding=utf-8
scriptencoding utf-8
set fileencodings=ucs-bom,utf-8,cp1251,latin1   " cp1251 for legacy RU files

" Before plugins load, or their <Leader> mappings bind to the old leader.
let mapleader = ","

" ============================================================================
"  Platform: shell
" ============================================================================
" Pin the whole cmd.exe family: $SHELL from MSYS2 / Git-Bash silently breaks
" :!, :grep and fzf under gVim.
if has('win32')
  set shell=cmd.exe
  set shellcmdflag=/s\ /c
  set shellquote=
  set shellxquote=\"
  set shellpipe=>%s\ 2>&1     " not '|' -- a bare '|' in :set is a separator
  set shellredir=>%s\ 2>&1
  set noshellslash
endif

" ============================================================================
"  General settings
" ============================================================================
" --- Behavior ---
set hidden
set history=10000
set undolevels=10000
set autoread
set belloff=all             " supersedes visualbell / errorbells
set backupcopy=yes          " copy, never rename: ~/_vimrc is a symlink
set timeoutlen=600          " safe only while leader groups stay prefix-free
set updatetime=300
set splitbelow splitright
set display=truncate

" 'lazyredraw' deliberately NOT set: torn glyphs under gVim + DirectWrite.

" Terminal-only feature; the GUI uses guifg/guibg directly. Needs +vtp on the
" Win32 console, else E954 here and E254 from lightline.
if !has('gui_running') && has('termguicolors')
      \ && (!has('win32') || has('vcon'))
  set termguicolors
endif

" Mirror YANKS only to '+'. 'clipboard=unnamed' would route deletes there too
" and clobber the OS clipboard; use "+p to paste from it.
if has('clipboard_working') && exists('##TextYankPost')
  augroup YankToClipboard
    autocmd!
    autocmd TextYankPost *
          \ if v:event.operator ==# 'y' && v:event.regname ==# '' |
          \   call setreg('+', v:event.regcontents, v:event.regtype) |
          \ endif
  augroup END
endif

" --- Text formatting and indentation ---
set nowrap
set sidescroll=1            " with 'nowrap', scroll by 1 col, not half a screen
set sidescrolloff=8
set tabstop=4
set shiftwidth=4
set expandtab
set softtabstop=4
set smarttab
set autoindent
set copyindent
set shiftround
set backspace=indent,eol,start

" --- Searching ---
set ignorecase
set smartcase
set hlsearch
set incsearch

if executable('rg')
  set grepprg=rg\ --vimgrep\ --no-heading\ --smart-case
  set grepformat=%f:%l:%c:%m
endif

" --- UI and display ---
set number
set relativenumber
set signcolumn=yes          " reserved always: ALE signs must not shift text
set scrolloff=8
set laststatus=2
set ruler                   " inert under lightline; matters in the no-plugin fallback
set title
set background=dark         " must precede :colorscheme for gruvbox
set mouse=a
set wildmenu
set wildmode=longest:full,full
set wildignore=*.swp,*.bak,*.pyc,*.class,*.o
silent! set wildoptions=pum " popup wildmenu; needs patch-8.2.4325

" 'showmatch' deliberately NOT set: it jumps the cursor to the match. The
" bundled matchparen plugin highlights the pair in place instead.

" ============================================================================
"  GUI: font and DirectWrite rendering
"
"  renmode MUST stay pinned to an integer-advance mode, or glyphs drift and
"  staircase across the line (docs/RATIONALE.md#directwrite-glyph-drift):
"
"    renmode:3  GDI_NATURAL        ClearType + integer advances  <- default here
"    renmode:2  GDI_CLASSIC        snaps hardest to the grid
"    renmode:5  NATURAL_SYMMETRIC  prettiest, fractional, drift-prone
"    renmode:0  DEFAULT            DirectWrite decides
"
"  If it ever reappears: <F10> cycles renmode, <F9> rebuilds the render
"  target, :RenderGDI drops to plain GDI (cannot drift).
" ============================================================================
if has('gui_running')
  " No ':cANSI' suffix -- it forces the ANSI codepage, so gVim picks a
  " FALLBACK font for Cyrillic, and two advance widths on one screen is itself
  " a source of misaligned glyphs. Consolas ships Cyrillic.
  set guifont=Consolas:h14
  set linespace=0             " deterministic line height; no vertical creep

  set guicursor=n-v-c:block,i-ci:ver25,r-cr:hor20

  if has('directx')
    if !exists('g:gui_renmode') | let g:gui_renmode = 3 | endif
    if !exists('g:gui_taamode') | let g:gui_taamode = 1 | endif  " 1 = CLEARTYPE
    if !exists('g:gui_geom')    | let g:gui_geom    = 1 | endif  " 1 = RGB stripe

    function! s:RopApply() abort
      let &renderoptions = printf('type:directx,geom:%d,renmode:%d,taamode:%d',
            \ g:gui_geom, g:gui_renmode, g:gui_taamode)
    endfunction

    " For glyphs that have ALREADY drifted: <C-l> only repaints the grid, it
    " does not re-create the render target, so the bad layout survives it.
    function! s:RenderReset() abort
      let l:saved = &renderoptions
      set renderoptions=
      redraw!
      let &renderoptions = l:saved
      redraw!
      echo 'render reset: ' . &renderoptions
    endfunction

    function! s:RenderCycle() abort
      let l:modes = [3, 2, 5, 0]
      let l:i = index(l:modes, g:gui_renmode)
      let g:gui_renmode = l:modes[(l:i + 1) % len(l:modes)]
      call s:RopApply()
      redraw!
      echo 'renmode=' . g:gui_renmode . '  ->  ' . &renderoptions
    endfunction

    function! s:RenderGDI() abort
      set renderoptions=
      redraw!
      echo 'renderer: GDI (renderoptions empty)'
    endfunction

    command! RenderReset call s:RenderReset()
    command! RenderCycle call s:RenderCycle()
    command! RenderGDI   call s:RenderGDI()
    command! RenderDX    call s:RopApply() | redraw!

    nnoremap <silent> <F9>  :RenderReset<CR>
    nnoremap <silent> <F10> :RenderCycle<CR>

    call s:RopApply()
  endif
endif

" ============================================================================
"  File and backup management
" ============================================================================
" State lives under ~/.vim, plugins under ~/vimfiles -- see docs/RATIONALE.md.
for s:dir in ['~/.vim/.undo', '~/.vim/.backup', '~/.vim/.swp']
  if !isdirectory(expand(s:dir))
    call mkdir(expand(s:dir), 'p')
  endif
endfor
set undodir=~/.vim/.undo//
set backupdir=~/.vim/.backup//
set directory=~/.vim/.swp//

" 'writebackup' keeps the crash-safety window during a write without
" accumulating history that git and 'undofile' already provide. Plain 'backup'
" had grown ~/.vim/.backup to 39 MB / 317 files, pruning nothing.
set swapfile nobackup writebackup undofile

" Vim never prunes these dirs; housekeeping lives outside this config:
"   dotfiles\vim-state-clean.bat                 report
"   dotfiles\vim-state-clean.bat --apply         prune the safe categories
"   dotfiles\vim-state-clean.bat --recover-cmds  `vim -r` for risky swaps

" ============================================================================
"  Plugins (vim-plug)
" ============================================================================
" Survive a fresh clone with no plug.vim yet: enable the basics and carry on.
if filereadable(expand('~/vimfiles/autoload/plug.vim'))

call plug#begin('~/vimfiles/plugged')

" Core
Plug 'itchyny/lightline.vim'
Plug 'morhetz/gruvbox'
Plug 'ward/VimCompletesMe'
Plug 'itchyny/vim-cursorword'

" File and history
" No 'do': fzf#install() -- fzf.exe comes from scoop and is on $PATH, so this
" clone only supplies the Vim plugin half.
Plug 'junegunn/fzf',  { 'dir': '~/.fzf' }
Plug 'junegunn/fzf.vim'
Plug 'mbbill/undotree', { 'on': 'UndotreeToggle' }

" Development and git
" Eager: lazy-loading on ['G','Git'] missed :Gclog / :Ghdiffsplit.
Plug 'tpope/vim-fugitive'
Plug 'tpope/vim-commentary'
Plug 'tpope/vim-surround'
" Eager: NERDTreeHijackNetrw only works if NERDTree is loaded when a directory
" is opened, so it cannot sit behind the toggle command.
Plug 'preservim/nerdtree'

Plug 'dense-analysis/ale'
Plug 'Propaz/karate-linter', { 'for': ['cucumber', 'karate'] }
" Deferred: vim-go is heavy and pulls in its own tooling.
Plug 'fatih/vim-go', { 'for': 'go', 'do': ':GoUpdateBinaries' }

call plug#end()

else
  echomsg 'vim-plug not found at ~/vimfiles/autoload/plug.vim -- plugins disabled.'
  filetype plugin indent on
  syntax enable
endif

" ============================================================================
"  Appearance
" ============================================================================
" 'silent!': before the first :PlugInstall a bare :colorscheme throws E185 and
" ABORTS the rest of this file.
silent! colorscheme gruvbox

" ============================================================================
"  Plugin configuration
" ============================================================================
" --- netrw / NERDTree ---
" netrw stays ENABLED: disabling it also kills 'gx' and fugitive's :GBrowse,
" and it contradicts hijacking, which is the supported way to combine them.
let g:NERDTreeMinimalUI = 1
let g:NERDTreeHijackNetrw = 1
let g:NERDTreeShowHidden = 1
let g:NERDTreeQuitOnOpen = 1

" Vim regex, not glob: '\v' would mean "very magic", so a bare '\venv' pattern
" collapses to 'env' and hides every path containing that substring.
let g:NERDTreeIgnore = [
    \ '\.pyc$', '\.swp$', '\.git$', '\.hg$', '\.svn$', '\.DS_Store$',
    \ '__pycache__', '^venv$', '\.venv', '\.mypy_cache'
    \ ]

" --- fzf ---
" Bottom split: avoids the floating-window rendering issues in gVim.
let g:fzf_layout = { 'down': '~40%' }

if executable('bat')
  let g:fzf_preview_window = ['right:50%:wrap', 'ctrl-/']
endif

" ':Ag' takes its flags from the command definition; g:fzf_ag_command is not
" read by fzf.vim at all, so override the command instead.
if executable('ag')
  command! -bang -nargs=* Ag
        \ call fzf#vim#ag(<q-args>, '--nocolor --nogroup --column --hidden',
        \                 fzf#vim#with_preview(), <bang>0)
endif

" --- lightline ---
let g:lightline = {
      \ 'colorscheme': 'gruvbox',
      \ 'active': {
      \   'left': [
      \     [ 'mode', 'paste' ],
      \     [ 'gitbranch', 'readonly', 'filename', 'modified' ]
      \   ]
      \ },
      \ 'component_function': {
      \   'gitbranch': 'FugitiveHead'
      \ }
      \ }

" --- ALE ---
" 'go': [] -- vim-go already provides Go diagnostics.
let g:ale_linters = {'python': ['ruff', 'mypy'], 'go': []}

" Both halves are needed: 'ruff_format' formats, 'ruff' applies lint fixes.
let g:ale_fixers = {
      \ 'python': ['ruff_format', 'ruff'],
      \ '*': ['remove_trailing_lines', 'trim_whitespace']
      \ }

let g:ale_fix_on_save = 1
let g:ale_completion_enabled = 1
let g:ale_completion_autoimport = 1
let g:ale_sign_warning = 'W>'
let g:ale_sign_error = 'E>'
set completeopt=menu,menuone,preview,noselect,noinsert

" mypy costs ~133 ms warm / ~565 ms cold even on a four-line file, and ALE's
" default re-runs it 200 ms after every pause in typing.
let g:ale_lint_on_text_changed = 'never'
let g:ale_lint_on_insert_leave = 1
let g:ale_lint_on_save = 1

" ============================================================================
"  Python toolchain (venv-aware)
" ============================================================================
" Run tools as `uv run <tool>` whenever a uv.lock sits above the buffer.
let g:ale_python_auto_uv = 1

" Read ONLY by the LSP linters (jedils, pylsp, pyright); no effect on
" ruff or mypy.
let g:ale_python_auto_virtualenv = 1

" ALE's completion and autoimport are LSP-only, so g:ale_completion_enabled
" above stays inert until one of these is present. First match wins.
let g:python_lsp_preference = get(g:, 'python_lsp_preference',
      \ ['pylsp', 'jedils', 'pyright'])

let s:python_lsp_exe = {
      \ 'pylsp':   'pylsp',
      \ 'jedils':  'jedi-language-server',
      \ 'pyright': 'pyright-langserver',
      \ }
let s:python_lsp_pkg = {
      \ 'pylsp':   'python-lsp-server',
      \ 'jedils':  'jedi-language-server',
      \ 'pyright': 'pyright',
      \ }

" Warn once per venv, not once per buffer.
let s:python_warned = {}

" Executable inside the venv, falling back to $PATH. Empty when absent.
function! s:PyExe(venv, exe) abort
  if !empty(a:venv)
    let l:p = a:venv . '\Scripts\' . a:exe . '.exe'

    if executable(l:p)
      return l:p
    endif
  endif

  return executable(a:exe) ? a:exe : ''
endfunction

function! s:PythonDetect() abort
  let l:info = {'venv': '', 'lsp': '', 'missing': [], 'ale': 1}

  " Do NOT guard this with exists('*ale#python#FindVirtualenv'): for an
  " autoload function not yet sourced, exists() returns 0, which would
  " silently disable detection on every first call. try/catch triggers the
  " autoload and still survives ALE being absent.
  try
    let l:info.venv = ale#python#FindVirtualenv(bufnr(''))
  catch /^Vim\%((\a\+)\)\=:E117/
    let l:info.ale = 0
  endtry

  for l:name in g:python_lsp_preference
    if !empty(s:PyExe(l:info.venv, get(s:python_lsp_exe, l:name, l:name)))
      let l:info.lsp = l:name
      break
    endif
  endfor

  for l:tool in ['ruff', 'mypy']
    if empty(s:PyExe(l:info.venv, l:tool))
      call add(l:info.missing, l:tool)
    endif
  endfor

  return l:info
endfunction

function! s:PythonSetup() abort
  let l:info = s:PythonDetect()

  if !l:info.ale
    return
  endif

  " Attach the LSP only when it exists, else ALE reports a missing executable
  " on every lint pass.
  let b:ale_linters = ['ruff', 'mypy']
        \ + (empty(l:info.lsp) ? [] : [l:info.lsp])

  " One warning per environment. A fully provisioned venv stays silent.
  let l:key = empty(l:info.venv) ? '<none>:' . expand('%:p:h') : l:info.venv

  if has_key(s:python_warned, l:key)
    return
  endif

  let s:python_warned[l:key] = 1

  let l:msgs = []
  let l:pkgs = []

  if empty(l:info.venv)
    " get(): ALE defines this in an autoload file that may not be sourced.
    call add(l:msgs, 'no virtualenv found above this file (looked for '
          \ . join(get(g:, 'ale_virtualenv_dir_names',
          \            ['.venv', 'env', 've', 'venv', 'virtualenv', '.env']), ', ')
          \ . ')')
  endif

  if !empty(l:info.missing)
    call add(l:msgs, 'not installed: ' . join(l:info.missing, ', '))
    call extend(l:pkgs, l:info.missing)
  endif

  if empty(l:info.lsp)
    call add(l:msgs, 'no LSP found -> completion and autoimport are disabled')
    call add(l:pkgs, get(s:python_lsp_pkg, g:python_lsp_preference[0], 'python-lsp-server'))
  endif

  if empty(l:msgs)
    return
  endif

  echohl WarningMsg
  for l:m in l:msgs
    echomsg 'python: ' . l:m
  endfor
  if !empty(l:pkgs)
    echomsg 'python: uv add --dev ' . join(l:pkgs, ' ')
  endif
  echohl None
endfunction

" What did detection actually pick for this buffer?
function! s:PythonToolInfo() abort
  let l:info = s:PythonDetect()
  echo 'venv    : ' . (empty(l:info.venv) ? '(none)' : l:info.venv)
  echo 'lsp     : ' . (empty(l:info.lsp) ? '(none)' : l:info.lsp
        \ . '  ->  ' . s:PyExe(l:info.venv, s:python_lsp_exe[l:info.lsp]))
  echo 'ruff    : ' . (empty(s:PyExe(l:info.venv, 'ruff')) ? '(none)' : s:PyExe(l:info.venv, 'ruff'))
  echo 'mypy    : ' . (empty(s:PyExe(l:info.venv, 'mypy')) ? '(none)' : s:PyExe(l:info.venv, 'mypy'))
  echo 'linters : ' . string(get(b:, 'ale_linters', get(g:ale_linters, 'python', [])))
endfunction
command! PythonToolInfo call s:PythonToolInfo()

" ============================================================================
"  Key mappings
"
"  INVARIANT: no leader mapping may be a PREFIX of another, or it waits out
"  'timeoutlen' (600 ms) on every use. Groups, all prefix-free:
"    ,c* clipboard   ,g* git   ,t* toggles   ,=* format   ,h* history
"    ,v* this config
"  Everything else is a leaf. Adding ',xy' when ',x' exists breaks ',x'.
"
"  The full table shared with ~/.ideavimrc is in README.md -- those keys mean
"  the same thing in gVim and in the JetBrains IDEs, so do not repurpose one
"  side without the other.
" ============================================================================

" --- Toggles and system ---
nnoremap <silent> <F2> :set paste!<CR>
nnoremap <silent> <F5> :UndotreeToggle<CR>
nnoremap <silent> <leader>tr :set relativenumber!<CR>
nnoremap <silent> <leader>tp :set paste!<CR>
nnoremap <silent> <leader>th :set hlsearch!<CR>
" $MYVIMRC resolves to the file Vim actually loaded.
nnoremap <leader>vm :edit $MYVIMRC<CR>
nnoremap <silent> <leader>vs :source $MYVIMRC<CR>:echo 'vimrc reloaded'<CR>
nnoremap <silent> <C-q> :q<CR>
nnoremap <silent> <leader>w :w<CR>

" --- Clipboard ---
nnoremap <silent> <leader>cf :let @+=expand('%:t')<CR>:echo 'filename copied'<CR>
nnoremap <silent> <leader>cp :let @+=expand('%:p')<CR>:echo 'full path copied'<CR>
nnoremap <silent> <leader>cd :lcd %:p:h<CR>:pwd<CR>
nnoremap <silent> <leader>cm :let @+ = execute('messages')<CR>:echo 'messages copied'<CR>

" --- Navigation and buffers ---
" Center the screen on page up/down.
nnoremap <silent> <PageUp>   <C-U>zz
xnoremap <silent> <PageUp>   <C-U>zz
inoremap <silent> <PageUp>   <C-O><C-U><C-O>zz
nnoremap <silent> <PageDown> <C-D>zz
xnoremap <silent> <PageDown> <C-D>zz
inoremap <silent> <PageDown> <C-O><C-D><C-O>zz

nnoremap <silent> <leader>e :NERDTreeToggle<CR>

nnoremap <silent> <leader>d :bprevious<Bar>bdelete #<CR>
nnoremap <silent> <leader>n :bnext<CR>
nnoremap <silent> <leader>p :bprevious<CR>

nnoremap <silent> <C-t> :tabnew<CR>
inoremap <silent> <C-t> <C-o>:tabnew<CR>
nnoremap <leader>1 1gt
nnoremap <leader>2 2gt
nnoremap <leader>3 3gt
nnoremap <leader>4 4gt
nnoremap <leader>5 5gt
nnoremap <leader>6 6gt
nnoremap <leader>7 7gt
nnoremap <leader>8 8gt
nnoremap <leader>9 9gt

" --- Editing and text manipulation ---
nnoremap <leader>a ggVG
" Blank line below/above WITHOUT leaving the current line. ',<CR>' is an alias
" for the old habit; ',o' / ',O' is what ~/.ideavimrc uses.
nnoremap <silent> <leader>o o<Esc>k
nnoremap <silent> <leader>O O<Esc>j
nnoremap <silent> <leader><CR> o<Esc>k
nnoremap <silent> <leader><space> :nohlsearch<CR>
" <Plug> mappings, so they follow &commentstring like gcc/gc do.
nmap <leader>/ <Plug>CommentaryLine
xmap <leader>/ <Plug>Commentary
" ',T' so the ',t*' toggle group stays prefix-free.
